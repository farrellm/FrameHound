# FrameHound settings. Copy to .env; every value shown is the default.

# Where movies, indexes and the SQLite db live (a volume in compose).
DATA_DIR=/data
# Model weight cache, shared by the api and the workers.
FH_MODELS_DIR=/data/models
# Model pins. "models.tiny.lock" swaps in tiny Whisper for development and CI;
# indexes are only searchable by an api running the same lock.
# FH_MODELS_LOCK=models.tiny.lock

# Empty runs jobs in threads inside the api (dev). Compose sets redis.
# REDIS_URL=redis://redis:6379/0

# Where indexing runs: colab (a rented Colab GPU, through the colab CLI) or
# local (this host; slow on a CPU).
INDEX_BACKEND=colab

# Colab. The CLI must be signed in (compose mounts ~/.config/colab-cli).
# COLAB_BIN=colab
# Sign-in strategy: empty uses the CLI's default (oauth2); "adc" for gcloud ADC.
# COLAB_AUTH=
# GPU to ask for first, then the fallback chain (T4, L4, G4, H100, A100).
COLAB_GPU=L4
GPU_FALLBACK=L4,T4
# Refuse to start a session below this compute-unit balance, or once this
# month's recorded spend reaches the budget.
MIN_BALANCE_CU=5
MONTHLY_BUDGET_CU=40
# Colab sessions at once; more index jobs wait for a free one.
MAX_COLAB_SESSIONS=1
# Seconds between progress polls of the VM, and between orphan-session sweeps.
COLAB_POLL_S=10
RECONCILE_S=900
# Fresh VMs to try when one is reclaimed mid-index.
COLAB_RETRIES=2

# Ingest limits.
MAX_DURATION=14400
MAX_BYTES=42949672960

# Torrents run on this host only (never on Colab), and fetch just the largest
# video file. Seed to this upload ratio when done (0 = stop at once), for at
# most SEED_MAX_S seconds. A torrent with no peers or progress for
# TORRENT_STALL_S seconds fails (0 = wait for peers indefinitely).
SEED_RATIO=0
SEED_MAX_S=3600
TORRENT_STALL_S=0
# Downloads at once (torrent or HTTP). worker-io runs this many jobs in
# parallel, and proxy transcodes and clips share them.
MAX_DOWNLOADS=3
# The BitTorrent ports (TCP and UDP): download k of MAX_DOWNLOADS listens on
# TORRENT_PORT + k, so keep TORRENT_PORT_LAST = TORRENT_PORT + MAX_DOWNLOADS - 1.
# Compose publishes the range on worker-io, on every interface, so peers can
# connect in; open it in the host firewall too.
# TORRENT_PORT=6881
# TORRENT_PORT_LAST=6883
# Outside compose: where libtorrent listens (compose sets it from TORRENT_PORT);
# later downloads add 1, 2, ... to each port.
# TORRENT_LISTEN=0.0.0.0:6881,[::]:6881
# Largest .torrent file accepted, in KB.
MAX_TORRENT_KB=2048

# Find movies by name in a Bitmagnet DHT crawler (docker/bitmagnet). Empty = off.
# In compose, enable the override instead, which sets it to http://bitmagnet:3333:
# COMPOSE_FILE=docker-compose.yml:docker-compose.bitmagnet.yml
# BITMAGNET_URL=
# BITMAGNET_TIMEOUT=10

# Disk quota for movies, in GB (0 = none). Past it, the least recently used
# movies lose clips first, then their original files (still searchable,
# re-download to clip), then everything (re-download and re-index).
MAX_DATA_GB=0

# Shared access token. Empty = no sign-in; then keep the app on localhost or a
# private network. Set it before exposing FrameHound anywhere else.
# FH_TOKEN=

# Indexing time limits, in seconds, and the no-progress watchdog.
INDEX_TIMEOUT=3600
LOCAL_INDEX_TIMEOUT=14400
STAGE_WATCHDOG=600
# zstd level for local index bundles (Colab bundles use 19).
INDEX_ZSTD_LEVEL=3

# Search.
TOP_K=10
HEAT_BINS=512
Z_MIN=3.0
# Show a picture: a face match scores Z_MIN + FACE_BONUS at the match similarity
# (0.40), plus FACE_SCALE per unit of similarity above it, so it outranks looks.
FACE_BONUS=2.0
FACE_SCALE=20
MAX_QUERY_IMAGE_MB=15

# Clips. GIFs are shorter.
MAX_CLIP_S=120
MAX_GIF_S=15
CLIP_TTL=86400

# ffmpeg sandbox limits.
FFMPEG_CPU_S=21600
FFMPEG_MEM_MB=6144
# 0 lets ffmpeg choose.
FFMPEG_THREADS=0

# A running job with no heartbeat for this long is marked failed.
STALE_JOB_S=300

# Dev/test only: allow downloads (and torrent peers) at private addresses.
# FH_ALLOW_PRIVATE_URLS=1
# Dev/test only: peers every torrent connects to, as host:port,...
# FH_TORRENT_PEERS=

# Host port for the web UI (bound to 127.0.0.1).
# FH_PORT=8080
